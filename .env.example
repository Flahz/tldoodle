# Copy to .env and fill in both keys.

# Narration. The key needs the "text_to_speech" permission (an unrestricted key from
# elevenlabs.io > Profile > API Keys is simplest). The free tier is non-commercial.
ELEVENLABS_API_KEY=

# Drawings (gpt-image-2.5-flare, one image per sentence: ~$0.018 each in the default
# half-price batch, ~$0.07 with --now).
OPENAI_API_KEY=
